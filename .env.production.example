# Production template — copy to `.env` in repo root before:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Never commit the filled `.env`.

APP_ENV=production
SECRET_KEY=
PII_ENCRYPTION_KEY=

# Public HTTPS URL (must match DOMAIN below)
PUBLIC_APP_URL=https://linkswiss.ch
DOMAIN=linkswiss.ch
TRUSTED_HOSTS=linkswiss.ch,www.linkswiss.ch

# Public UI features (off by default in production)
PUBLIC_SEARCH_ENABLED=true
PUBLIC_SIGNUP_ENABLED=true
SIGNUP_AUTO_VERIFY=false

# Database password (used by postgres service + DATABASE_URL override in compose)
POSTGRES_PASSWORD=

# Admin — generate hash: python scripts/generate_admin_hash.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

RATE_LIMIT=60/minute

# WhatsApp webhook (Meta → https://linkswiss.ch/api/v1/webhooks/whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_INBOUND_AUTO_VERIFY=true
WHATSAPP_VERIFY_KEYWORD=OK

# Email
NOTIFIER_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Live ingest — keep false until legal review
INGEST_DISPATCH_ALERTS=false
INGEST_HOMEGATE_LIVE=false
INGEST_JOBS_LIVE=false
INGEST_FLATFOX_LIVE=false
INGEST_IMMOSCOUT_LIVE=false
INGEST_NEWHOME_LIVE=false
INGEST_ANIBIS_LIVE=false
INGEST_JOBUP_LIVE=false
INGEST_LEBONCOIN_LIVE=false
INGEST_INDEED_FR_LIVE=false

# France Travail (ex-Pole Emploi) — official OAuth2 API, not scraping. Free account
# + app at https://francetravail.io, subscribe to "Offres d'emploi v2" to get these.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET= # gitleaks:allow
FRANCE_TRAVAIL_DEPARTEMENT=74
FRANCE_TRAVAIL_KEYWORDS=
INGEST_FRANCE_TRAVAIL_LIVE=false

# Adzuna — official self-serve job aggregator API, built for redistribution, not
# scraping. Free key at https://developer.adzuna.com/signup (instant, no approval wait).
ADZUNA_APP_ID=
ADZUNA_APP_KEY= # gitleaks:allow
ADZUNA_COUNTRY=ch
ADZUNA_KEYWORDS=
ADZUNA_LOCATION=Geneve
INGEST_ADZUNA_LIVE=false

# SmartRecruiters — official, keyless Postings API used by several large Geneva
# employers for their public career sites (e.g. HUG, SGS). No signup, no API key,
# not scraping (see docs/providers/smartrecruiters.md).
SMARTRECRUITERS_COMPANIES=HUG,SGS
SMARTRECRUITERS_FETCH_DETAILS=true
INGEST_SMARTRECRUITERS_LIVE=false

# Richemont — public Workday CXS API (same JSON API careers.richemont.com's own JS
# calls). No signup, no API key, not scraping (see docs/providers/richemont.md).
RICHEMONT_EXTRA_LOCATION_HINTS=
INGEST_RICHEMONT_LIVE=false

# Phase B — Stripe Premium (CHF). Webhook URL:
#   https://linkswiss.ch/api/v1/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_ENABLE_TWINT=true

# Optional error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional AI assistant (free-form chat in the guide bot). Leave ASSISTANT_API_KEY
# empty to keep the assistant disabled (frontend falls back to the button-only guide).
# Costs are pay-per-use, kept in check by ASSISTANT_RATE_LIMIT and
# ASSISTANT_MAX_OUTPUT_TOKENS. Works with any OpenAI-compatible endpoint:
#
# Option A — OpenAI (https://platform.openai.com/api-keys):
# ASSISTANT_API_KEY=sk-...
# ASSISTANT_API_BASE_URL=https://api.openai.com/v1/chat/completions
# ASSISTANT_MODEL=gpt-4o-mini
#
# Option B — Google Gemini, OpenAI-compatible mode (https://aistudio.google.com/apikey).
# Gemini 3 models "think" before answering and count that reasoning against
# ASSISTANT_MAX_OUTPUT_TOKENS, so set ASSISTANT_REASONING_EFFORT=minimal to avoid
# truncated replies. Leave ASSISTANT_REASONING_EFFORT empty for OpenAI (gpt-4o-mini
# rejects this parameter).
# ASSISTANT_API_KEY=AIza...
# ASSISTANT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# ASSISTANT_MODEL=gemini-3.6-flash
# ASSISTANT_REASONING_EFFORT=minimal
ASSISTANT_API_KEY=
ASSISTANT_API_BASE_URL=https://api.openai.com/v1/chat/completions
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_REASONING_EFFORT=
ASSISTANT_MAX_OUTPUT_TOKENS=700
ASSISTANT_MAX_INPUT_CHARS=500
ASSISTANT_MAX_HISTORY_MESSAGES=6
ASSISTANT_RATE_LIMIT=20/day

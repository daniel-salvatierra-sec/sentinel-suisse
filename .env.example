# Application
APP_ENV=development
SECRET_KEY=

# Public UI / verification links (Phase 18+)
PUBLIC_APP_URL=http://127.0.0.1:5173
# Phase 33 — comma-separated hostnames for production (TrustedHost middleware)
# TRUSTED_HOSTS=your-domain.example
# Phase 23 — omit for auto (on in development); set true to allow signup in production
# PUBLIC_SIGNUP_ENABLED=true
# Phase 27 — omit for auto (on in development); set true to allow search in production
# PUBLIC_SEARCH_ENABLED=true
# Omit for auto-verify in development; set false to always send verification links
# SIGNUP_AUTO_VERIFY=false

# PII encryption at rest (Phase 8) — generate: python scripts/generate_pii_key.py
PII_ENCRYPTION_KEY=

# API (Phase 2 — localhost only)
API_HOST=127.0.0.1
API_PORT=8000
RATE_LIMIT=30/minute

# Database
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_suisse

# Redis
REDIS_URL=redis://localhost:6379/0

# Admin (Phase 2) — generate hash: python scripts/generate_admin_hash.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# WhatsApp Cloud API (Phase 7 / 23) — Meta Graph API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook handshake + signature (Phase 23)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Phase 24 — auto-verify WhatsApp channel when user messages the business number
WHATSAPP_INBOUND_AUTO_VERIFY=true
# Phase 25 — user must reply this exact word (case-insensitive). Empty = any message.
WHATSAPP_VERIFY_KEYWORD=OK

# Auto-dispatch alerts after ingest when new listings are created (Phase 7)
INGEST_DISPATCH_ALERTS=false

# Homegate live ingest (Phase 13) — disabled by default; review ToS/robots.txt first
INGEST_HOMEGATE_LIVE=false
INGEST_RATE_LIMIT_SECONDS=3
# Drop listings not seen in ingest after this many hours (housing + jobs).
LISTING_FRESH_HOURS=48
HOMEGATE_SEARCH_URL=https://www.homegate.ch/mieten/immobilien/kanton-genf/trefferliste

# jobs.ch live ingest (Phase 14) — disabled by default
INGEST_JOBS_LIVE=false
JOBS_SEARCH_URL=https://www.jobs.ch/en/vacancies/?location=Geneva

# Flatfox live ingest — public pin + listing JSON (not HTML). Disabled by default.
INGEST_FLATFOX_LIVE=false
FLATFOX_NORTH=46.32
FLATFOX_SOUTH=46.12
FLATFOX_EAST=6.30
FLATFOX_WEST=5.95
FLATFOX_MAX_LISTINGS=200

# ImmoScout24 live ingest (Phase 21) — disabled by default
INGEST_IMMOSCOUT_LIVE=false
IMMOSCOUT_SEARCH_URL=https://www.immoscout24.ch/fr/immobilier/louer/lieu-geneve

# Phase 40 — more CH providers (live disabled by default)
INGEST_NEWHOME_LIVE=false
NEWHOME_SEARCH_URL=https://www.newhome.ch/fr/louer/geneve
INGEST_ANIBIS_LIVE=false
ANIBIS_SEARCH_URL=https://www.anibis.ch/fr/immobilier--8/annonces/geneve
INGEST_JOBUP_LIVE=false
JOBUP_SEARCH_URL=https://www.jobup.ch/fr/emplois/?location=Gen%C3%A8ve

# Phase 41 — France border (live disabled by default)
INGEST_LEBONCOIN_LIVE=false
LEBONCOIN_SEARCH_URL=https://www.leboncoin.fr/recherche?category=10&locations=Annemasse_74100__45.9024_6.2364_5000
INGEST_INDEED_FR_LIVE=false
INDEED_FR_SEARCH_URL=https://fr.indeed.com/jobs?q=&l=Annemasse+%2874%29&radius=25

# France Travail (ex-Pole Emploi) — official OAuth2 API, not scraping (see
# docs/providers/france-travail.md). Free account + app at https://francetravail.io.
INGEST_FRANCE_TRAVAIL_LIVE=false
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET= # gitleaks:allow
FRANCE_TRAVAIL_DEPARTEMENT=74
FRANCE_TRAVAIL_KEYWORDS=

# Adzuna — official self-serve job aggregator API, built for redistribution, not
# scraping (see docs/providers/adzuna.md). Free key at https://developer.adzuna.com/signup.
INGEST_ADZUNA_LIVE=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY= # gitleaks:allow
ADZUNA_COUNTRY=ch
ADZUNA_KEYWORDS=
ADZUNA_LOCATION=Geneve

# Adzuna France — same keys, Haute-Savoie / Geneva border (see docs/providers/adzuna.md).
# Substitute for France Travail while francetravail.io remains unusable.
INGEST_ADZUNA_FR_LIVE=false
ADZUNA_FR_LOCATION=Annemasse
ADZUNA_FR_KEYWORDS=

# SmartRecruiters — official, keyless Postings API used by several large Geneva
# employers for their public career sites (e.g. HUG, SGS). No signup, no API key,
# not scraping (see docs/providers/smartrecruiters.md).
INGEST_SMARTRECRUITERS_LIVE=false
SMARTRECRUITERS_COMPANIES=HUG,SGS
SMARTRECRUITERS_FETCH_DETAILS=true

# Richemont — public Workday CXS API (same JSON API careers.richemont.com's own JS
# calls). No signup, no API key, not scraping (see docs/providers/richemont.md).
# RICHEMONT_EXTRA_LOCATION_HINTS lets you add more CH/FR place names (comma-separated)
# without a code change if Richemont opens a site somewhere not already covered.
INGEST_RICHEMONT_LIVE=false
RICHEMONT_EXTRA_LOCATION_HINTS=

# Lombard Odier — same public Workday CXS API as Richemont (see
# docs/providers/lombard-odier.md). No signup, no API key, not scraping.
INGEST_LOMBARD_ODIER_LIVE=false
LOMBARD_ODIER_EXTRA_LOCATION_HINTS=

# Logitech — same public Workday CXS API as Richemont (see
# docs/providers/logitech.md). No signup, no API key, not scraping.
INGEST_LOGITECH_LIVE=false
LOGITECH_EXTRA_LOCATION_HINTS=

# Procter & Gamble — same public Workday CXS API as Richemont (see
# docs/providers/procter-gamble.md). No signup, no API key, not scraping.
INGEST_PROCTER_GAMBLE_LIVE=false
PROCTER_GAMBLE_EXTRA_LOCATION_HINTS=

# Temenos — same public Workday CXS API as Richemont (see
# docs/providers/temenos.md). No signup, no API key, not scraping.
INGEST_TEMENOS_LIVE=false
TEMENOS_EXTRA_LOCATION_HINTS=

# STMicroelectronics — public Eightfold JSON API (see
# docs/providers/stmicroelectronics.md). No signup, no API key, not scraping.
INGEST_STMICROELECTRONICS_LIVE=false

# Notifier (Phase 6) — auto | console | smtp
NOTIFIER_MODE=auto

# Email (Phase 6) — e.g. Mailtrap for dev: sandbox.smtp.mailtrap.io
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase B — Stripe Checkout (leave empty to disable Pay Premium)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_ENABLE_TWINT=true
# Optional: SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional AI assistant (free-form chat) — leave ASSISTANT_API_KEY empty to disable.
# Works with OpenAI or Google Gemini's OpenAI-compatible endpoint (see
# .env.production.example for both options).
# ASSISTANT_API_KEY=
# ASSISTANT_API_BASE_URL=https://api.openai.com/v1/chat/completions
# ASSISTANT_MODEL=gpt-4o-mini
# ASSISTANT_RATE_LIMIT=20/day

# Play Store TWA — SHA-256 of the signing cert, comma-separated (empty until Play upload)
# ANDROID_PACKAGE_ID=ch.linkswiss.app
# PLAY_ASSETLINKS_SHA256=
